# Anthropic API Key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Steam Web API Key (optional) — https://steamcommunity.com/dev/apikey
# Required for player avatar images and Steam profile links in the Player view.
STEAM_API_KEY=

# CS2 / HLAE
CS2_EXE=C:\Program Files (x86)\Steam\steamapps\common\Counter-Strike Global Offensive\game\bin\win64\cs2.exe
CS2_STEAM_PATH=C:\Program Files (x86)\Steam
CS2_NETCON_PORT=2121
CS2_LAUNCH_OPTIONS=-novid
CS2_WIDTH=1920
CS2_HEIGHT=1080
CS2_HLAE_EXE=C:\Program Files (x86)\HLAE\HLAE.exe
CS2_HLAE_HOOK_DLL=C:\Program Files (x86)\HLAE\x64\AfxHookSource2.dll
CS2_HLAE_CONFIG_DIR=C:\cs2-coach\hlae_cfg
CS2_HLAE_LAUNCH_TEMPLATE=

# Render backend
RENDER_BACKEND=hlae
RENDER_OUTPUT_ROOT=outputs/generated
RENDER_TEMP_ROOT=outputs/generated/tmp
HLAE_RENDER_BACKEND=mirv_streams
HLAE_RENDER_FPS=60
HLAE_RENDER_WIDTH=1920
HLAE_RENDER_HEIGHT=1080
HLAE_RENDER_IMAGE_FORMAT=png
HLAE_RENDER_PRE_ROLL_TICKS=128
HLAE_RENDER_POST_ROLL_TICKS=128
HLAE_RENDER_LOAD_TIMEOUT_S=20
HLAE_RENDER_SEEK_TIMEOUT_S=10
HLAE_RENDER_POV_TIMEOUT_S=8
HLAE_RENDER_OUTPUT_TIMEOUT_S=30

# FFmpeg
FFMPEG_EXE=ffmpeg
FFPROBE_EXE=ffprobe
POSTPROCESS_PRESET=veryfast
POSTPROCESS_CRF=20
